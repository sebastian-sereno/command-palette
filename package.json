{
  "name": "command-palette",
  "version": "1.0.0",
  "main": "src/index.ts",
  "author": "Sebastian Sereno",
  "license": "All Rights Reserved",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^26.6.2",
    "lefthook": "^2.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "commitlint": "^21.2.1",
    "cz-conventional-changelog": "^3.3.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "type-enum": [
      "build",
      "chore",
      "ci",
      "docs",
      "feat",
      "fix",
      "patch",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  }
}
